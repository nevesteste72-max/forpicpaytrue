{
  "rewrites": [
    { "source": "/takealot.com", "destination": "/takealot.com/index.html" },
     { "source": "/takealot.com/checkout", "destination": "/takealot.com/checkout.html" },
    { "source": "/saudebovina", "destination": "/saudebovina/index.html" },
    { "source": "/saudebovina/", "destination": "/saudebovina/index.html" },
    { "source": "/saudebovina/back", "destination": "/saudebovina/back/index.html" },
    { "source": "/saudebovina/back/", "destination": "/saudebovina/back/index.html" },
    { "source": "/saudebovina/upsell1", "destination": "/saudebovina/upsell1/index.html" },
    { "source": "/saudebovina/upsell1/", "destination": "/saudebovina/upsell1/index.html" },
    { "source": "/painel", "destination": "/painel/index.html" },
    { "source": "/painel/", "destination": "/painel/index.html" },
    { "source": "/aves", "destination": "/aves/index.html" },
    { "source": "/aves/", "destination": "/aves/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/saudebovina/(.*).(mp4|webm|webp|jpg|jpeg|png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
